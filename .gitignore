# build_dinput8.sh writes its objects and pdbs here.
Files/Matchmaking/build/

# Byakuya builder/spender concept: the saved web page. Working material, not
# patch content. Its _files/ folder is deliberately NOT ignored.
Byakuya Builder Spender Rework.html

# Local double-click wrapper around rig_up.ps1. The rig script itself is
# shared; this front door is personal convenience.
BalanceLeadTools/Rig Up.bat

# fix_intro_postreset.py keeps the pre-edit intro packages here. 224 MB of
# copies, and they live OUTSIDE GameVersions/ on purpose: install_overlay walks
# the whole Overlay tree and would install a .bak sitting next to its original
# into the game's Demo/ folder.
BalanceLeadTools/intro_cut/backups/

# force_wide_evolve_cam.py keeps the stock evolve packages here, 125 MB of
# copies that exist only to revert with.
BalanceLeadTools/evolve_cam/backups/

# The cut intro + map-camera Overlay files, parked here while we A/B whether the
# intro skip is what displaces player 2. Put back with the restore below; NOT a
# committed state.
BalanceLeadTools/intro_cut/disabled_overlay/
BalanceLeadTools/intro_cut/backups_p2jump/

# The three-client rig. Same reasoning as the .bat wrapper: dev-only tooling
# that hardcodes machine layout, and the two-client rig_up.ps1 stays shared.
BalanceLeadTools/rig_up3.ps1
BalanceLeadTools/Rig Up 3.bat
